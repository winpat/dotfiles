#!/bin/sh

# Wallpaper
swaybg -i ~/shared/media/images/Wallpaper/2650x1440/john-towner-JgOeRuGD_Y4-unsplash.jpg -m fill &

# Multi-monitor output profiles
kanshi &

# Bar, network applet, notifications
sfwbar &
nm-applet &
dunst &

# Removable media: auto-mount USB drives (udisks2 does the mounting; udiskie is
# the session daemon that watches for insert events). -a automount, -n notify,
# -t tray icon (shows in sfwbar's tray; click to unmount/eject). Mounts land
# under /run/media/patrick/.
udiskie -a -n -t &

# Clipboard history (cliphist): wl-paste watchers feed clipboard changes into
# cliphist's database; the store wrapper skips password-manager copies and
# collapses incremental mouse selections (see scripts/cliphist-store).
wl-paste --type text --watch ~/.config/labwc/scripts/cliphist-store text &
wl-paste --type image --watch ~/.config/labwc/scripts/cliphist-store image &

# Selection sync: mirror PRIMARY (mouse select / middle-click) and CLIPBOARD
# (Ctrl+C / Ctrl+V) onto each other, the way copyq used to. Only CLIPBOARD is
# recorded in the history — a primary selection reaches cliphist by way of the
# clipboard it gets mirrored into. See scripts/clipboard-sync for the loop
# guard that keeps the two watchers from ping-ponging.
wl-paste --type text --watch ~/.config/labwc/scripts/clipboard-sync to-primary &
wl-paste --primary --type text --watch ~/.config/labwc/scripts/clipboard-sync to-clipboard &

# wl-clip-persist re-owns a selection when the source window closes, since
# wlroots drops it otherwise. `both` rather than `regular`, so a closed window
# does not leave PRIMARY empty while CLIPBOARD keeps the content — that
# divergence is exactly what the sync above exists to prevent.
wl-clip-persist --clipboard both &

# Restart emacs daemon after wayland is available. Otherwise emacsclient
# can't launch in GUI mode.
dbus-update-activation-environment --systemd --all
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
systemctl --user restart emacs.service

# Terminal on login
ghostty &
