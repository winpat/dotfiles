#!/bin/sh
# rofi-based passmenu for `pass` (Wayland/labwc replacement for X11 `passmenu`).
#
# Lists password-store entries in rofi, then COPIES the selected password to the
# clipboard for pasting. The copy is tagged with the password-manager hint
# (application/x-kde-passwordManagerHint = secret), which copyq honors: the
# password is pasteable but is NOT recorded in copyq's clipboard history. The
# password is fed to copyq via stdin, so it never appears in process arguments.
# The clipboard is cleared after 45s (like `pass -c`) if still unchanged.
#
# Bound to Super+p in ~/.config/labwc/rc.xml.

store="${PASSWORD_STORE_DIR:-$HOME/.password-store}"

entry=$(
  find -L "$store" -name '*.gpg' -type f \
    | sed -e "s@^$store/@@" -e 's@\.gpg$@@' \
    | sort \
    | rofi -dmenu -i -p pass
)

[ -n "$entry" ] || exit 0

pw=$(pass show "$entry" | head -n 1)
[ -n "$pw" ] || exit 0

printf '%s' "$pw" | copyq copy text/plain - application/x-kde-passwordManagerHint secret

# Clear the clipboard after 45s, but only if it still holds this password.
( sleep 45; [ "$(copyq clipboard 2>/dev/null)" = "$pw" ] && wl-copy --clear ) &
