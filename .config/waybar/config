{
	"layer": "top",
	"position": "top",
	"height": 34,

	"modules-left": ["hyprland/workspaces", "custom/window"],
	"modules-center": ["clock"],
	"modules-right": ["pulseaudio", "network", "battery", "tray"],

	"hyprland/workspaces": {
		"format": "{id}",
		"on-click": "activate",
		"sort-by-number": true
	},

	"clock": {
		"format": "{:%a %b %d  %I:%M %p}"
	},

	"battery": {
		"format": "{capacity}% {icon}",
		"format-icons": ["", "", "", "", ""]
	},

	"network": {
		"format-wifi": "  {essid}",
		"format-ethernet": "󰈀 wired",
		"format-disconnected": "offline"
	},

	"pulseaudio": {
		"format": "  {volume}%"
	}

}
