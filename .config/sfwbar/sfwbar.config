Set Term = "sakura"

function("SfwbarInit") {
  SetBarId "bar-0"
  SetLayer "top"
}

include("winops.widget")

layout "sfwbar" {
  # Pin the bar to the external 4K monitor at the office. sfwbar uses the
  # connector name here (not kanshi's descriptive name). Falls back to the
  # default output when HDMI-A-1 isn't connected.
  monitor = "HDMI-A-1"

  # The bar's rendered height is 38px (measured on-screen: the opaque bar
  # background spans exactly 38 rows above the output's bottom edge; the 18px
  # clock font plus button/tray padding, margins and borders add up past the
  # 30px button min-height). Pin the exclusive zone to that integer so labwc
  # reserves precisely the bar's height -- an under-count (the old "30") lets
  # windows extend into the unreserved strip, where the top-layer bar then
  # draws over them, hiding the bottom of every window (emacs, browsers, ...).
  # A fixed integer is used over the default "auto" zone because fractional
  # output scaling (the office Dell runs at 1.33) rounds "auto" inconsistently,
  # leaving a ~1px window/bar overlap (masked here by the opaque background).
  # If the bar's CSS changes its height, re-measure and update this value (or
  # switch to "auto", which self-tracks the height at the cost of that ~1px).
  exclusive_zone = "38"

  # Bottom-left: workspace pager. labwc exposes 4 named desktops (1-4 in
  # rc.xml), so the pins line up with the workspace names.
  pager {
    style = "pager"
    rows = 1
    pins = "1","2","3","4"
    preview = false
    primary_axis = rows
  }

  taskbar {
    rows = 1
    # NOTE: no grouping. `group = true` (popup mode) crashes in sfwbar
    # 1.0_beta17 on hover (popup_show / taskbar_popup_enter_cb), and
    # `group = pager` isn't supported on labwc. Flat taskbar is the stable option.
    icons = true
    labels = true
    title_width = 25
    # Only show windows belonging to the currently active workspace.
    filter = workspace
    # Right-click (button 3) closes the window under the cursor.
    action[3] = Close
  }

  # Expanding spacer pushes everything after it to the bottom-right.
  label { css = "* { -GtkWidget-hexpand: true; min-height: 30px; }" }

  # System tray (StatusNotifierItem), left of the date/time.
  tray {
    rows = 1
  }

  widget "clock.widget" {
    disable = false;
    time_format = "%H:%M"
    tooltip_format = "%H:%M\n%x"
    week_starts_on_sunday = false
    reset_on_popup = false
  }
}

#CSS
/* Arc-Darker palette (matches labwc themerc-override / GTK Arc-Darker) */
/* Opaque background: the office Dell runs at a fractional scale (1.328125)
   that doesn't divide the 4K panel into whole logical pixels, causing a ~1px
   window/bar overlap. An opaque bar hides it (a transparent one made it
   visible). Restore the alpha (0.6) if you move to a clean integer scale. */
@define-color lab_bg_color RGB(12, 13, 18);
@define-color lab_active_color #3a5f8a;
@define-color lab_hover_color RGBA(255, 255, 255, 0.1);
/* Taskbar: selected window uses the subtle translucent white (was the hover
   color); hover uses a slightly stronger tint so it still stands out. */
@define-color lab_taskbar_select_color RGBA(255, 255, 255, 0.1);
@define-color lab_taskbar_hover_color RGBA(255, 255, 255, 0.22);
@define-color lab_text_color #d3dae3;
@define-color lab_menu_bg_color #383c4a;

window {
  -GtkWidget-direction: bottom;
  background-color: @lab_bg_color;
}

label {
  font-size: 14px;
  color: @lab_text_color;
  text-shadow: none;
}

button,
button image {
  outline-style: none;
  box-shadow: none;
  background-image: none;
  border-image: none;
  border-radius: 0;
  min-height: 30px;
  min-width: 30px;
  margin: 0px;
  margin-right: 3px;
  border: 0px;
  background-color: RGBA(0, 0, 0, 0.0);
  -GtkWidget-valign: center;
}

button:hover {
  background-color: @lab_hover_color;
}

button#taskbar_group_normal,
button#taskbar_group_normal:hover,
button#taskbar_group_active {
  border: 0px;
  -GtkWidget-valign: center;
}

button#taskbar_group_active {
  background-color: @lab_active_color;
}

button#taskbar_group_active:hover {
  background-color: @lab_hover_color;
}

/* Flat taskbar (no grouping): the focused window's button. beta17 tags it
   with .focused (see bundled t2.config); .active is kept for robustness
   across versions. Highlight it like the focused pager item. */
button#taskbar_item.focused,
button#taskbar_item.active {
  background-color: @lab_taskbar_select_color;
}

/* Hover on any taskbar item (including the focused one) uses the stronger
   tint. Listed after the selected rule so it wins for the focused item. */
button#taskbar_item:hover,
button#taskbar_item.focused:hover,
button#taskbar_item.active:hover {
  background-color: @lab_taskbar_hover_color;
}

#menu_item,
#menu_item *,
#menu_item image,
#menu_item label {
  -GtkWidget-halign: start;
  color: @lab_text_color;
}

#menu_item:hover,
#menu_item:hover *,
#menu_item:hover label {
  background-color: @lab_active_color;
  color: #ffffff;
}

#menu_item image {
  min-width: 16px;
  min-height: 16px;
  padding-right: 2px;
  margin-right: 7px;
  margin-left: 3px;
}

menu {
  background-color: @lab_menu_bg_color;
}

menu arrow {
  background: none;
}

label#clock {
  color: @lab_text_color;
  -GtkWidget-vexpand: true;
  -GtkWidget-valign: center;
  font-size: 18px;
  margin-right: 8px;
}

label#date {
  color: @lab_text_color;
  -GtkWidget-vexpand: true;
  -GtkWidget-valign: center;
  font-size: 14px;
  margin-right: 10px;
}

/* Workspace pager (bottom-left) */
grid#pager {
  -GtkWidget-valign: center;
  margin-left: 4px;
}

button#pager_item {
  color: @lab_text_color;
  background-color: RGBA(0, 0, 0, 0.0);
  border: 0px;
  border-radius: 3px;
  min-width: 26px;
  min-height: 26px;
  margin-right: 3px;
  -GtkWidget-valign: center;
}

button#pager_item:hover {
  background-color: @lab_hover_color;
}

button#pager_item.focused {
  background-color: @lab_active_color;
  color: #ffffff;
}

/* System tray */
button#tray_item {
  margin: 0px;
  margin-right: 2px;
  border: none;
  padding: 0px;
  background-color: RGBA(0, 0, 0, 0.0);
}

button#tray_item.passive {
  -GtkWidget-visible: false;
}

button#tray_item image {
  -GtkWidget-valign: center;
  -GtkWidget-vexpand: true;
  /* Explicit size shrinks the icons a bit and makes sfwbar request themed
     icons at this resolution (crisper than upscaling the app's raw pixmap). */
  min-width: 18px;
  min-height: 18px;
  padding: 2px;
  margin: 0px;
  border: none;
  -ScaleImage-symbolic: false;
}